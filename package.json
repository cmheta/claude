{
  "name": "whatsapp-price-agent",
  "version": "1.0.0",
  "description": "WhatsApp bot that tracks UK clothing prices and notifies when target price is hit",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "twilio": "^5.3.0",
    "undici": "^6.10.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
